{
	"name": "client",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "main.cjs",
	"scripts": {
		"dev": "vite",
		"start-server": "cd ../server && npm start",
		"build": "vue-tsc && vite build && node postBuild.cjs",
		"preview": "vite preview",
		"test:e2e": "cypress run",
		"test:unit": "vitest",
		"lint": "eslint .",
		"start": "electron .",
		"package": "electron-builder"
	},
	"dependencies": {
		"@capacitor/app": "6.0.2",
		"@capacitor/core": "6.2.0",
		"@capacitor/haptics": "6.0.2",
		"@capacitor/keyboard": "6.0.3",
		"@capacitor/status-bar": "6.0.2",
		"@fortawesome/fontawesome-free": "^6.7.2",
		"@ionic/vue": "^8.0.0",
		"@ionic/vue-router": "^8.0.0",
		"@vue/compiler-sfc": "^3.5.13",
		"axios": "^1.7.9",
		"bootstrap": "^5.3.3",
		"expr-eval": "^2.0.2",
		"html2pdf.js": "^0.10.2",
		"ionicons": "^7.4.0",
		"pinia": "^2.2.8",
		"systemjs": "^6.15.1",
		"vue": "^3.3.0",
		"vue-router": "^4.2.0"
	},
	"devDependencies": {
		"@capacitor/cli": "6.2.0",
		"@types/bootstrap": "^5.2.10",
		"@types/nodemailer": "^6.4.17",
		"@vitejs/plugin-legacy": "^5.0.0",
		"@vitejs/plugin-vue": "^4.0.0",
		"@vue/eslint-config-typescript": "^12.0.0",
		"@vue/test-utils": "^2.3.0",
		"concurrently": "^9.1.2",
		"cypress": "^13.5.0",
		"electron": "^22.3.27",
		"electron-builder": "^25.1.8",
		"eslint": "^8.35.0",
		"eslint-plugin-vue": "^9.9.0",
		"jsdom": "^22.1.0",
		"rollup-plugin-visualizer": "^5.14.0",
		"terser": "^5.4.0",
		"typescript": "^5.6.2",
		"vite": "^5.4.14",
		"vitest": "^0.34.6",
		"vue-tsc": "^2.1.10"
	},
	"description": "Aplicación del Laboratorio Clínico Madre Emilia",
	"author": "mario",
	"build": {
		"appId": "com.laboratorio.id",
		"productName": "laboratorio",
		"icon": "./public/images/icono.png",
		"files": [
			"dist/**/*",
			"server/**/*",
			"main.cjs",
			"package.json"
		],
		"extraResources": [
			{
				"from": "server/",
				"to": "server/"
			}
		]
	}
